# Telegram & Supabase Environment Variables

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Supabase Local or Cloud credentials
# (When running in Supabase Edge Functions, SUPABASE_URL and SUPABASE_ANON_KEY are automatically injected,
# but can be set explicitly for local testing or custom deployment)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
